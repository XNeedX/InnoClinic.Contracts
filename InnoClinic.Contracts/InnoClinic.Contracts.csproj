    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>InnoClinic.Contracts</PackageId>
    <Version>1.0.0</Version> <Authors>NeedXw</Authors>
    <Company>InnoClinic</Company>
    <Description>Shared contracts and events for InnoClinic microservices</Description>
